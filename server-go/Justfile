set shell := ["powershell.exe", "-NoProfile", "-Command"]

# List the available recipes.
default:
    @just --list

# Build the server and admin tools into bin/.
build:
    go build -o bin/vxaos-server.exe ./cmd/vxaos-server
    go build -o bin/vxaos-admin.exe ./cmd/vxaos-admin
    go build -o bin/vxaos-load.exe ./cmd/vxaos-load

# Build and start the development server with config.toml.
run: build
    .\bin\vxaos-server.exe -config config.toml

# Start the already-built server with config.toml.
start:
    .\bin\vxaos-server.exe -config config.toml

# Run the Go test suite.
test:
    go test ./...

# Run go vet.
vet:
    go vet ./...

# Format, vet and test.
check:
    gofmt -w .
    go vet ./...
    go test ./...

# Create the 500 disposable bot accounts and characters.
load-setup: build
    .\bin\vxaos-load.exe -setup -config config.load.toml -count 500

# Drive 500 bots against a server already running on 127.0.0.1:5050.
load: build
    .\bin\vxaos-load.exe -config config.load.toml -addr 127.0.0.1:5050 -count 500 -duration 60s -ramp 10s -move-every 500ms -attack-every 2s -json bin\load-test-baseline.json

# Create a distributable 7z with the server, admin tool, data and config.
dist: build
    powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-dist.ps1
